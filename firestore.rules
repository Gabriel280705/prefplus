rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada cidadão só lê e grava os próprios dados (perfil, alvarás, IPTU, ouvidoria, processos, agendamentos)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Horários de agendamento: todos veem o que está ocupado; só o dono cria/cancela o seu
    match /slots/{slot} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Contador de protocolos: só pode crescer de 1 em 1
    match /counters/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id == 'protocolo' && request.resource.data.seq == 4583;
      allow update: if request.auth != null && id == 'protocolo'
                    && request.resource.data.seq == resource.data.seq + 1;
    }
  }
}
